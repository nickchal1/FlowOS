---
const PRICE_MONTHLY = 9;
const PRICE_ANNUAL  = 89;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FlowOS — The AI Focus Copilot for Mac</title>
  <meta name="description" content="FlowOS lives in your menu bar, catches distraction spirals, plans your day from your calendar, and snaps you back into flow — before you've lost the hour." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}
    body{background:#0a0a0c;color:#fff;font-family:"Inter",system-ui,sans-serif;margin:0;overflow-x:hidden}
    .mono{font-family:"JetBrains Mono",monospace}
    .hero-glow{background:radial-gradient(ellipse 80% 50% at 50% -5%,rgba(99,102,241,.22) 0%,transparent 70%)}
    body::before{content:"";position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E");pointer-events:none;z-index:0}
    .popover{background:#0c0c0e;border:1px solid rgba(255,255,255,.08);border-radius:14px;overflow:hidden;box-shadow:0 32px 64px rgba(0,0,0,.8),0 0 0 1px rgba(255,255,255,.04)}
    .gt{background:linear-gradient(135deg,#fff 0%,rgba(255,255,255,.55) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .gti{background:linear-gradient(135deg,#a5b4fc 0%,#818cf8 50%,#c084fc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
    .reveal.visible{opacity:1;transform:none}
    .rd1{transition-delay:.1s}.rd2{transition-delay:.2s}.rd3{transition-delay:.3s}
    .sep{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.06) 30%,rgba(255,255,255,.06) 70%,transparent)}
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    .float{animation:float 5s ease-in-out infinite}
    @keyframes fadeIn{from{opacity:0;transform:translateX(-4px)}to{opacity:1;transform:none}}
    .log-entry{animation:fadeIn .25s ease forwards}
    .pc{transition:transform .2s,box-shadow .2s}
    .pc:hover{transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,.6),0 0 40px rgba(99,102,241,.1)}
    .grid-bg{background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);background-size:64px 64px}
    .tl-line{background:linear-gradient(to bottom,transparent,rgba(99,102,241,.3) 20%,rgba(99,102,241,.3) 80%,transparent)}

    /* ── Desktop simulation ── */
    #ds-outer{width:100%;overflow:hidden;border-radius:14px;border:1px solid rgba(255,255,255,.08);box-shadow:0 40px 80px rgba(0,0,0,.8)}
    #ds-inner{width:860px;position:relative;background:linear-gradient(145deg,#0d1117 0%,#0a0d1a 50%,#0d1117 100%)}
    /* Menubar */
    .ds-menubar{height:28px;background:rgba(10,10,15,.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:space-between;padding:0 16px;position:relative;z-index:50}
    .ds-menubar-left{display:flex;align-items:center;gap:16px;font-size:11px;font-weight:500;color:rgba(255,255,255,.7)}
    .ds-menubar-right{display:flex;align-items:center;gap:12px;font-size:11px;color:rgba(255,255,255,.55)}
    .ds-flowos-icon{display:flex;align-items:center;gap:5px;background:rgba(99,102,241,.15);border:1px solid rgba(99,102,241,.3);border-radius:6px;padding:2px 7px;cursor:pointer}
    /* Desktop workspace */
    .ds-workspace{position:relative;height:420px;overflow:hidden}
    /* Dock */
    .ds-dock{height:56px;display:flex;align-items:center;justify-content:center;gap:10px;background:rgba(255,255,255,.03);border-top:1px solid rgba(255,255,255,.05);padding:0 20px;position:relative;z-index:10}
    .ds-dock-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;transition:transform .15s;cursor:pointer;background:rgba(255,255,255,.06)}
    .ds-dock-icon:hover{transform:scale(1.2) translateY(-4px)}
    /* Windows */
    .dwin{position:absolute;border-radius:10px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.1);transition:left .65s cubic-bezier(.4,0,.2,1),top .65s cubic-bezier(.4,0,.2,1),width .65s cubic-bezier(.4,0,.2,1),height .65s cubic-bezier(.4,0,.2,1),opacity .3s ease,transform .3s ease;display:flex;flex-direction:column}
    .dbar{height:28px;background:#2d2d30;display:flex;align-items:center;padding:0 10px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.07);gap:0}
    .tl{display:flex;gap:5px;margin-right:auto}
    .tl span{width:10px;height:10px;border-radius:50%;display:block}
    .tr{background:#ff5f56}.ty{background:#febc2e}.tg{background:#28c840}
    .dtitle{font-size:11px;color:rgba(255,255,255,.4);position:absolute;left:50%;transform:translateX(-50%);pointer-events:none;white-space:nowrap}
    .dwbody{flex:1;overflow:hidden;display:flex}
    /* VSCode styles */
    .vsc-sidebar{width:140px;background:#1a1a1d;border-right:1px solid rgba(255,255,255,.05);padding:6px;flex-shrink:0;overflow:hidden}
    .vsc-editor{flex:1;padding:8px 6px;font-family:"JetBrains Mono",monospace;font-size:10px;line-height:1.6;overflow:hidden}
    .vsc-ln{color:rgba(255,255,255,.15);user-select:none;margin-right:12px;display:inline-block;width:14px;text-align:right}
    .vc-kw{color:#c084fc}.vc-fn{color:#fde68a}.vc-str{color:#86efac}.vc-id{color:#e2e8f0}.vc-ty{color:#93c5fd}.vc-cm{color:rgba(255,255,255,.3)}
    /* Chrome styles */
    .chr-tabbar{height:32px;background:#292a2d;display:flex;align-items:flex-end;padding:0 8px;gap:0;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.06)}
    .ctab{display:inline-flex;align-items:center;gap:5px;max-width:130px;min-width:0;overflow:hidden;white-space:nowrap;transition:max-width .4s ease,opacity .35s ease,padding .4s ease,background .35s ease,border-color .35s ease;padding:0 10px;height:28px;font-size:10px;border-radius:8px 8px 0 0;cursor:pointer;color:rgba(255,255,255,.5);flex-shrink:0;border:1px solid transparent;border-bottom:none;position:relative}
    .ctab.active{background:#3c3d41;color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.1)}
    .ctab.closing{max-width:0;opacity:0;padding:0;min-width:0}
    .ctab.grp-dev{background:rgba(59,130,246,.18);border-top:2px solid #3b82f6;color:#93c5fd}
    .ctab.grp-social{background:rgba(249,115,22,.12);border-top:2px solid #f97316}
    .ctab.grp-docs{background:rgba(34,197,94,.12);border-top:2px solid #22c55e;color:#86efac}
    .chr-urlbar{height:28px;background:#1e1e20;display:flex;align-items:center;padding:0 10px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,.06)}
    .chr-urlbar span{font-size:10px;color:rgba(255,255,255,.3);font-family:"JetBrains Mono",monospace}
    .chr-body{flex:1;overflow:hidden}
    /* Terminal */
    .term-body{flex:1;background:#0d1117;padding:10px;font-family:"JetBrains Mono",monospace;font-size:10px;line-height:1.7;overflow:hidden}
    /* Slack */
    .slk-sidebar{width:130px;background:#1a1d21;border-right:1px solid rgba(255,255,255,.05);padding:8px;flex-shrink:0;overflow:hidden}
    .slk-body{flex:1;background:#1a1d21;padding:8px;overflow:hidden}
    /* Spotify */
    .spt-body{flex:1;background:#121212;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px;gap:6px}
    /* FlowOS popover in desktop */
    #ds-popover{position:absolute;top:32px;right:12px;z-index:100;width:240px;transition:opacity .3s ease,transform .3s ease;transform-origin:top right}
    #ds-popover.hidden{opacity:0;transform:scale(.95);pointer-events:none}
    /* Scenario narration */
    #ds-narration{font-size:13px;color:rgba(255,255,255,.55);min-height:20px;transition:opacity .3s}
    /* Step progress */
    .dstep-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.15);transition:background .3s;cursor:pointer}
    .dstep-dot.active{background:rgba(99,102,241,.9)}
    /* Group label badge */
    .grp-badge{display:inline-block;font-size:8px;padding:1px 4px;border-radius:3px;font-weight:600;margin-left:3px;opacity:0;transition:opacity .4s ease}
    .grp-badge.show{opacity:1}
    /* Closing overlay for windows */
    @keyframes ping{0%{transform:scale(1);opacity:1}75%,100%{transform:scale(2);opacity:0}}
    @keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
    @keyframes pulseRing{0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.4)}50%{box-shadow:0 0 0 6px rgba(239,68,68,0)}}
  </style>
</head>
<body class="relative z-10">

<!-- ── NAV ─────────────────────────────────────────────── -->
<nav class="sticky top-0 z-50 border-b border-white/[0.04] bg-[#0a0a0c]/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <div class="flex items-center gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-indigo-500/20 ring-1 ring-indigo-500/30">
        <svg class="h-4 w-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      </div>
      <span class="text-[15px] font-semibold">FlowOS</span>
      <span class="rounded-full bg-indigo-500/15 px-2 py-0.5 text-[10px] font-medium text-indigo-300 ring-1 ring-indigo-500/20">for Mac</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="#desktop-demo" class="hidden text-[13px] text-white/40 hover:text-white transition-colors sm:block">Demo</a>
      <a href="#pricing" class="hidden text-[13px] text-white/40 hover:text-white transition-colors sm:block">Pricing</a>
      <a href="#pricing" class="rounded-xl bg-indigo-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-indigo-500 transition-colors">Get Pro</a>
    </div>
  </div>
</nav>

<!-- ── HERO ─────────────────────────────────────────────── -->
<section class="hero-glow grid-bg py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-14 lg:flex-row">
      <div class="flex-1 text-center lg:text-left">
        <div class="reveal mb-5 inline-flex items-center gap-2 rounded-full bg-white/[0.05] px-3 py-1.5 ring-1 ring-white/[0.08]">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[11px] text-white/50">Version 1.0 — 7-day free trial</span>
        </div>
        <h1 class="reveal rd1 mb-5 text-[44px] font-black leading-[1.06] tracking-tight md:text-[56px]">
          <span class="gt">Stop the spiral.</span><br/>Own your focus.
        </h1>
        <p class="reveal rd2 mb-8 max-w-md text-[16px] leading-relaxed text-white/45">
          FlowOS is a 340px menu-bar AI. It watches your app switches, reads your calendar, and steps in — without a meeting, a habit tracker, or a productivity system.
        </p>
        <div class="reveal rd3 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
          <a href="#desktop-demo" class="flex items-center gap-2 rounded-xl bg-white/[0.08] px-6 py-3 text-[14px] font-medium text-white hover:bg-white/[0.12] transition-colors ring-1 ring-white/[0.10]">Watch it control your Mac ↓</a>
          <a href="#pricing" class="flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-[14px] font-semibold text-white hover:bg-indigo-500 transition-colors">Download for Mac</a>
        </div>
        <p class="reveal mt-4 text-[11px] text-white/20">macOS 13+ · Apple Silicon & Intel · No subscription required for basic use</p>
      </div>
      <div class="reveal rd2 float shrink-0">
        <div class="popover w-[280px]">
          <div class="flex items-center justify-between border-b border-white/[0.05] px-3 py-2.5">
            <div class="flex items-center gap-2">
              <div class="h-6 w-6 rounded-lg bg-indigo-500/20 flex items-center justify-center"><svg class="h-3 w-3 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>
              <span class="text-[12px] font-semibold">FlowOS</span>
            </div>
            <div class="rounded-lg bg-emerald-500/15 px-2 py-0.5 flex items-center gap-1.5"><div class="h-1.5 w-1.5 rounded-full bg-emerald-400"></div><span class="text-[10px] font-semibold text-emerald-400">82</span></div>
          </div>
          <div class="flex border-b border-white/[0.05] px-1">
            <button class="px-3 py-2 text-[11px] font-medium text-white border-b-2 border-indigo-500">Home</button>
            <button class="px-3 py-2 text-[11px] text-white/30">Capsule</button>
            <button class="px-3 py-2 text-[11px] text-white/30">Analytics</button>
          </div>
          <div class="p-3 space-y-2">
            <div class="rounded-xl bg-white/[0.04] ring-1 ring-white/[0.07] px-3 py-2.5 flex items-center gap-2"><div class="h-4 w-4 rounded-full bg-red-500/20 flex items-center justify-center"><div class="h-1.5 w-1.5 rounded-full bg-red-400"></div></div><span class="text-[11px] text-white/35">Hold ⌘⇧K to speak…</span></div>
            <div class="grid grid-cols-3 gap-1.5">
              <button class="rounded-xl py-2 text-[10px] font-medium bg-indigo-600/70 text-white ring-1 ring-indigo-500/50">Coding</button>
              <button class="rounded-xl py-2 text-[10px] text-white/35 bg-white/[0.03] ring-1 ring-white/[0.05]">Research</button>
              <button class="rounded-xl py-2 text-[10px] text-white/35 bg-white/[0.03] ring-1 ring-white/[0.05]">Auto</button>
            </div>
            <button class="w-full rounded-xl bg-white/[0.04] ring-1 ring-white/[0.07] px-3 py-2 flex items-center justify-between"><div><div class="text-[11px] font-medium text-white text-left">Start Tracking</div><div class="text-[10px] text-white/30">Record activity context</div></div></button>
          </div>
        </div>
        <div class="mx-auto mt-4 h-6 w-40 rounded-full bg-indigo-500/20 blur-2xl"></div>
      </div>
    </div>
  </div>
</section>

<div class="sep mx-auto max-w-6xl my-0"></div>

<!-- ── DESKTOP SIMULATION ────────────────────────────────── -->
<section id="desktop-demo" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mb-10 text-center">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-indigo-400">Live Demo</p>
      <h2 class="text-[34px] font-black tracking-tight md:text-[42px]">Your actual Mac.<br/><span class="gti">FlowOS in control.</span></h2>
      <p class="mt-3 text-[14px] text-white/40">Pick a scenario and watch the desktop respond to a single voice command.</p>
    </div>

    <!-- Scenario buttons -->
    <div class="reveal mb-6 flex flex-wrap justify-center gap-2" id="ds-scenario-tabs">
      <button data-ds="0" class="ds-tab active rounded-xl bg-indigo-600/80 px-4 py-2 text-[12px] font-semibold text-white ring-1 ring-indigo-500/50">⌨️ Coding Mode</button>
      <button data-ds="1" class="ds-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors">🗂 Group Tabs</button>
      <button data-ds="2" class="ds-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors">🔒 Focus Lock</button>
    </div>

    <!-- Narration + step controls -->
    <div class="reveal mb-3 flex items-center justify-between px-1">
      <p id="ds-narration" class="text-[13px] text-white/50 flex-1 mr-6">A typical Monday morning. Five apps open, none of them helping you ship.</p>
      <div class="flex items-center gap-3 shrink-0">
        <button id="ds-pause" class="text-[11px] text-white/30 hover:text-white/60 transition-colors">⏸</button>
        <div id="ds-dots" class="flex gap-1.5"></div>
      </div>
    </div>

    <!-- Desktop simulation -->
    <div class="reveal" id="ds-outer">
      <div id="ds-inner">

        <!-- Menubar -->
        <div class="ds-menubar">
          <div class="ds-menubar-left">
            <span style="font-size:15px">&#63743;</span>
            <span>Code</span>
            <span>File</span>
            <span>Edit</span>
            <span>View</span>
          </div>
          <div class="ds-menubar-right">
            <svg style="width:12px;height:12px;opacity:.5" viewBox="0 0 24 24" fill="currentColor"><path d="M1.5 8.5a13 13 0 0121 0M5 12a10 10 0 0114 0M8.5 15.5a6 6 0 017 0M12 19h.01"/></svg>
            <span>100%</span>
            <span id="ds-clock" style="font-variant-numeric:tabular-nums">10:43</span>
            <div class="ds-flowos-icon" id="ds-menubar-btn">
              <svg style="width:10px;height:10px;color:#818cf8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0"/></svg>
              <span style="font-size:10px;color:#a5b4fc;font-weight:600">FlowOS</span>
            </div>
          </div>
        </div>

        <!-- Desktop workspace -->
        <div class="ds-workspace" id="ds-workspace">

          <!-- ── VSCode window ── -->
          <div class="dwin" id="dwin-vscode" style="left:10px;top:8px;width:390px;height:318px;z-index:10">
            <div class="dbar"><div class="tl"><span class="tr"></span><span class="ty"></span><span class="tg"></span></div><span class="dtitle">auth.ts — VS Code</span></div>
            <div class="dwbody">
              <div class="vsc-sidebar">
                <div style="font-size:9px;color:rgba(255,255,255,.2);margin-bottom:6px;font-family:system-ui;font-weight:600;letter-spacing:.08em">EXPLORER</div>
                <div style="font-size:10px;color:rgba(255,255,255,.45);padding:2px 4px;font-family:monospace">📁 src</div>
                <div style="font-size:10px;color:rgba(255,255,255,.75);padding:2px 4px 2px 16px;font-family:monospace;background:rgba(99,102,241,.12);border-radius:4px">📄 auth.ts</div>
                <div style="font-size:10px;color:rgba(255,255,255,.4);padding:2px 4px 2px 16px;font-family:monospace">📄 api.ts</div>
                <div style="font-size:10px;color:rgba(255,255,255,.4);padding:2px 4px 2px 16px;font-family:monospace">📄 types.ts</div>
                <div style="font-size:10px;color:rgba(255,255,255,.4);padding:2px 4px;font-family:monospace">📁 components</div>
                <div style="font-size:10px;color:rgba(255,255,255,.4);padding:2px 4px;font-family:monospace">📁 hooks</div>
                <div style="font-size:10px;color:rgba(255,255,255,.4);padding:2px 4px;font-family:monospace">📁 lib</div>
              </div>
              <div class="vsc-editor" style="background:#1e1e1e">
                <div><span class="vsc-ln">1</span><span class="vc-kw">import</span> <span class="vc-id">&#123; createClient &#125;</span> <span class="vc-kw">from</span> <span class="vc-str">'@supabase/supabase-js'</span></div>
                <div><span class="vsc-ln">2</span></div>
                <div><span class="vsc-ln">3</span><span class="vc-kw">export</span> <span class="vc-ty">async function</span> <span class="vc-fn">signIn</span><span class="vc-id">(</span></div>
                <div><span class="vsc-ln">4</span>  <span class="vc-id">email: </span><span class="vc-ty">string</span><span class="vc-id">,</span></div>
                <div><span class="vsc-ln">5</span>  <span class="vc-id">password: </span><span class="vc-ty">string</span></div>
                <div><span class="vsc-ln">6</span><span class="vc-id">) &#123;</span></div>
                <div style="background:rgba(99,102,241,.1)"><span class="vsc-ln">7</span>  <span class="vc-kw">const</span> <span class="vc-id">&#123; data, error &#125; =</span> <span class="vc-kw">await</span></div>
