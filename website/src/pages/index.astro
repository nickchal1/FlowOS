// ── Demo engine ───────────────────────────────────────────────
let scenario = 0;
let step = 0;
let paused = false;
let timer: ReturnType<typeof setTimeout> | null = null;

function applyStep(s: number) {
  const kf = SCENARIOS[scenario]![s];
  if (!kf) return;
  document.getElementById("ds-narration")!.textContent = kf.narration;
  document.getElementById("ds-step-label")!.textContent = `step ${s + 1} / ${SCENARIOS[scenario]!.length}`;
  kf.exec?.();
  // Update dots
  const dotsEl = document.getElementById("ds-dots")!;
  dotsEl.querySelectorAll(".dstep-dot").forEach((d, i) => {
    d.classList.toggle("active", i === s);
  });
}

function buildDots() {
  const dotsEl = document.getElementById("ds-dots")!;
  dotsEl.innerHTML = "";
  SCENARIOS[scenario]!.forEach((_, i) => {
    const d = document.createElement("div");
    d.className = "dstep-dot" + (i === step ? " active" : "");
    d.addEventListener("click", () => { step = i; clearT(); applyStep(step); if (!paused) schedT(); });
    dotsEl.appendChild(d);
  });
}

function clearT() { if (timer) { clearTimeout(timer); timer = null; } }
function schedT() {
  clearT();
  const delay = SCENARIOS[scenario]![step]?.delay ?? 3000;
  timer = setTimeout(() => {
    step = (step + 1) % SCENARIOS[scenario]!.length;
    applyStep(step);
    buildDots();
    if (!paused) schedT();
  }, delay);
}

function loadScenario(idx: number) {
  scenario = idx;
  step = 0;
  clearT();
  applyStep(0);
  buildDots();
  if (!paused) schedT();
  document.querySelectorAll(".ds-tab").forEach((b, i) => {
    const active = i === idx;
    (b as HTMLElement).className = active
      ? "ds-tab active rounded-xl bg-indigo-600/80 px-4 py-2 text-[12px] font-semibold text-white ring-1 ring-indigo-500/50"
      : "ds-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors";
  });
}

document.getElementById("ds-pause")!.addEventListener("click", () => {
  paused = !paused;
  (document.getElementById("ds-pause") as HTMLElement).textContent = paused ? "▶" : "⏸";
  if (paused) clearT(); else schedT();
});
document.getElementById("ds-prev")!.addEventListener("click", () => {
  step = (step - 1 + SCENARIOS[scenario]!.length) % SCENARIOS[scenario]!.length;
  clearT(); applyStep(step); buildDots(); if (!paused) schedT();
});
document.getElementById("ds-next")!.addEventListener("click", () => {
  step = (step + 1) % SCENARIOS[scenario]!.length;
  clearT(); applyStep(step); buildDots(); if (!paused) schedT();
});
document.querySelectorAll(".ds-tab").forEach((btn, i) => {
  btn.addEventListener("click", () => loadScenario(i));
});

// Boot
loadScenario(0);
</script>

