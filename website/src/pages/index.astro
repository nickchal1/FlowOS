---
const PRICE_MONTHLY = 9;
const PRICE_ANNUAL  = 89;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FlowOS — The AI Focus Copilot for Mac</title>
  <meta name="description" content="FlowOS lives in your menu bar, catches distraction spirals, plans your day from your calendar, and snaps you back into flow — before you've lost the hour." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box}
    body{background:#0a0a0c;color:#fff;font-family:"Inter",system-ui,sans-serif;margin:0;overflow-x:hidden}
    .mono{font-family:"JetBrains Mono",monospace}
    /* Glow */
    .hero-glow{background:radial-gradient(ellipse 80% 50% at 50% -5%,rgba(99,102,241,.22) 0%,transparent 70%)}
    /* Noise */
    body::before{content:"";position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E");pointer-events:none;z-index:0}
    /* Popover */
    .popover{background:#0c0c0e;border:1px solid rgba(255,255,255,.08);border-radius:14px;overflow:hidden;box-shadow:0 32px 64px rgba(0,0,0,.8),0 0 0 1px rgba(255,255,255,.04)}
    /* Gradient text */
    .gt{background:linear-gradient(135deg,#fff 0%,rgba(255,255,255,.55) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .gti{background:linear-gradient(135deg,#a5b4fc 0%,#818cf8 50%,#c084fc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    /* Scroll reveal */
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
    .reveal.visible{opacity:1;transform:none}
    .rd1{transition-delay:.1s}.rd2{transition-delay:.2s}.rd3{transition-delay:.3s}
    /* Separator */
    .sep{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.06) 30%,rgba(255,255,255,.06) 70%,transparent)}
    /* Float */
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    .float{animation:float 5s ease-in-out infinite}
    /* Log entry typing */
    @keyframes fadeIn{from{opacity:0;transform:translateX(-4px)}to{opacity:1;transform:none}}
    .log-entry{animation:fadeIn .25s ease forwards}
    /* Popover state transition */
    .popover-state{animation:fadeIn .3s ease forwards}
    /* Progress bar */
    @keyframes progress{from{width:0%}to{width:100%}}
    .progress-bar{animation:progress linear forwards}
    /* Cursor blink */
    @keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
    .cursor{animation:blink .8s step-end infinite}
    /* Mac menubar */
    .menubar{background:rgba(0,0,0,.7);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
    /* Pricing hover */
    .pc{transition:transform .2s,box-shadow .2s}
    .pc:hover{transform:translateY(-4px);box-shadow:0 20px 60px rgba(0,0,0,.6),0 0 40px rgba(99,102,241,.1)}
    /* Timeline line */
    .tl-line{background:linear-gradient(to bottom,transparent,rgba(99,102,241,.3) 20%,rgba(99,102,241,.3) 80%,transparent)}
    /* Grid bg */
    .grid-bg{background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);background-size:64px 64px}
  </style>
</head>

<body class="relative z-10">

<!-- ── NAV ─────────────────────────────────────────────── -->
<nav class="sticky top-0 z-50 border-b border-white/[0.04] bg-[#0a0a0c]/80 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <div class="flex items-center gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-indigo-500/20 ring-1 ring-indigo-500/30">
        <svg class="h-4 w-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
      </div>
      <span class="text-[15px] font-semibold">FlowOS</span>
      <span class="rounded-full bg-indigo-500/15 px-2 py-0.5 text-[10px] font-medium text-indigo-300 ring-1 ring-indigo-500/20">for Mac</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="#demo" class="hidden text-[13px] text-white/40 hover:text-white transition-colors sm:block">Demo</a>
      <a href="#pricing" class="hidden text-[13px] text-white/40 hover:text-white transition-colors sm:block">Pricing</a>
      <a href="#pricing" class="rounded-xl bg-indigo-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-indigo-500 transition-colors">Get Pro</a>
    </div>
  </div>
</nav>

<!-- ── HERO ─────────────────────────────────────────────── -->
<section class="hero-glow grid-bg py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center gap-14 lg:flex-row">

      <div class="flex-1 text-center lg:text-left">
        <div class="reveal mb-5 inline-flex items-center gap-2 rounded-full bg-white/[0.05] px-3 py-1.5 ring-1 ring-white/[0.08]">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-[11px] text-white/50">Version 1.0 — try it free for 7 days</span>
        </div>
        <h1 class="reveal rd1 mb-5 text-[44px] font-black leading-[1.06] tracking-tight md:text-[56px]">
          <span class="gt">Stop the spiral.</span><br/>Own your focus.
        </h1>
        <p class="reveal rd2 mb-8 max-w-md text-[16px] leading-relaxed text-white/45">
          FlowOS is a 340px menu-bar AI. It watches your app switches, reads your calendar, and steps in — without a meeting, a habit tracker, or a productivity system.
        </p>
        <div class="reveal rd3 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
          <a href="#demo" class="flex items-center gap-2 rounded-xl bg-white/[0.08] px-6 py-3 text-[14px] font-medium text-white hover:bg-white/[0.12] transition-colors ring-1 ring-white/[0.10]">
            Watch it work ↓
          </a>
          <a href="#pricing" class="flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-[14px] font-semibold text-white hover:bg-indigo-500 transition-colors">
            Download for Mac
          </a>
        </div>
        <p class="reveal mt-4 text-[11px] text-white/20">macOS 13+ · Apple Silicon & Intel · No subscription required for basic use</p>
      </div>

      <!-- Popover hero mockup -->
      <div class="reveal rd2 float shrink-0">
        <div class="popover w-[300px]">
          <div class="flex items-center justify-between border-b border-white/[0.05] px-3 py-2.5">
            <div class="flex items-center gap-2">
              <div class="h-6 w-6 rounded-lg bg-indigo-500/20 flex items-center justify-center">
                <svg class="h-3 w-3 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
              </div>
              <span class="text-[12px] font-semibold">FlowOS</span>
            </div>
            <div class="rounded-lg bg-emerald-500/15 px-2 py-0.5 flex items-center gap-1.5">
              <div class="h-1.5 w-1.5 rounded-full bg-emerald-400"></div>
              <span class="text-[10px] font-semibold text-emerald-400">82</span>
            </div>
          </div>
          <div class="flex border-b border-white/[0.05] px-1">
            <button class="px-3 py-2 text-[11px] font-medium text-white border-b-2 border-indigo-500">Home</button>
            <button class="px-3 py-2 text-[11px] text-white/30">Capsule</button>
            <button class="px-3 py-2 text-[11px] text-white/30">Analytics</button>
          </div>
          <div class="p-3 space-y-2">
            <div class="rounded-xl bg-white/[0.04] ring-1 ring-white/[0.07] px-3 py-2.5 flex items-center gap-2">
              <div class="h-4 w-4 rounded-full bg-red-500/20 flex items-center justify-center"><div class="h-1.5 w-1.5 rounded-full bg-red-400"></div></div>
              <span class="text-[11px] text-white/35">Hold ⌘⇧K to speak…</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5">
              <button class="rounded-xl py-2 text-[10px] font-medium bg-indigo-600/70 text-white ring-1 ring-indigo-500/50">Coding</button>
              <button class="rounded-xl py-2 text-[10px] text-white/35 bg-white/[0.03] ring-1 ring-white/[0.05]">Research</button>
              <button class="rounded-xl py-2 text-[10px] text-white/35 bg-white/[0.03] ring-1 ring-white/[0.05]">Auto</button>
            </div>
            <button class="w-full rounded-xl bg-white/[0.04] ring-1 ring-white/[0.07] px-3 py-2.5 flex items-center justify-between">
              <div><div class="text-[11px] font-medium text-white text-left">Start Tracking</div><div class="text-[10px] text-white/30">Record activity context</div></div>
            </button>
            <button class="w-full rounded-xl bg-white/[0.04] ring-1 ring-white/[0.07] px-3 py-2.5 flex items-center justify-between">
              <div><div class="text-[11px] font-medium text-white text-left">Plan Tomorrow</div><div class="text-[10px] text-white/30">AI schedules your day</div></div>
              <div class="h-1.5 w-1.5 rounded-full bg-purple-400 opacity-60"></div>
            </button>
          </div>
        </div>
        <div class="mx-auto mt-4 h-6 w-40 rounded-full bg-indigo-500/20 blur-2xl"></div>
      </div>
    </div>
  </div>
</section>

<div class="sep mx-auto max-w-6xl my-0"></div>

<!-- ── INTERACTIVE DEMO ──────────────────────────────────── -->
<section id="demo" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mb-12 text-center">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-indigo-400">Live Demo</p>
      <h2 class="text-[34px] font-black tracking-tight md:text-[42px]">See exactly what FlowOS sees.<br/><span class="gti">And what it does about it.</span></h2>
      <p class="mt-3 text-[14px] text-white/40">Real event data on the left. The UI you'd see on the right.</p>
    </div>

    <!-- Scenario tabs -->
    <div class="reveal mb-6 flex flex-wrap justify-center gap-2" id="scenario-tabs">
      <button data-scenario="0" class="scenario-tab active rounded-xl bg-indigo-600/80 px-4 py-2 text-[12px] font-semibold text-white ring-1 ring-indigo-500/50">🌀 Distraction Spiral</button>
      <button data-scenario="1" class="scenario-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors">🎙 Voice Command</button>
      <button data-scenario="2" class="scenario-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors">📅 Meeting Prep</button>
      <button data-scenario="3" class="scenario-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors">🌙 Night Before</button>
    </div>

    <!-- Demo stage -->
    <div class="reveal rounded-2xl bg-white/[0.03] ring-1 ring-white/[0.07] overflow-hidden">
      <!-- Narration bar -->
      <div class="border-b border-white/[0.05] px-5 py-3 flex items-center justify-between">
        <p id="demo-narration" class="text-[13px] text-white/60 flex-1 mr-4">It's 10:42 AM. You've been in deep work for 47 minutes. Focus score: 82.</p>
        <div class="flex items-center gap-3 shrink-0">
          <button id="demo-pause" class="text-[11px] text-white/30 hover:text-white/60 transition-colors">⏸ Pause</button>
          <div class="flex gap-1.5" id="demo-dots"></div>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="h-0.5 bg-white/[0.05]">
        <div id="demo-progress-bar" class="h-full bg-indigo-500/60 w-0 transition-none"></div>
      </div>

      <!-- Two panes -->
      <div class="grid lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-white/[0.05]">

        <!-- Left: event log -->
        <div class="p-5">
          <div class="mb-3 flex items-center gap-2">
            <div class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></div>
            <span class="mono text-[10px] text-white/25 uppercase tracking-[0.12em]">FlowOS event stream</span>
          </div>
          <div id="demo-log" class="mono space-y-1 text-[11px] min-h-[220px]"></div>
        </div>

        <!-- Right: FlowOS UI -->
        <div class="p-5 flex items-start justify-center">
          <div>
            <div class="mb-3 flex items-center gap-2">
              <div class="h-2 w-2 rounded-full bg-indigo-400"></div>
              <span class="mono text-[10px] text-white/25 uppercase tracking-[0.12em]">What you see</span>
            </div>
            <div id="demo-ui" class="flex justify-center"></div>
          </div>
        </div>

      </div>

      <!-- Step nav -->
      <div class="border-t border-white/[0.05] px-5 py-3 flex items-center justify-between">
        <button id="demo-prev" class="text-[12px] text-white/30 hover:text-white/60 transition-colors">← Prev</button>
        <span id="demo-step-label" class="text-[11px] text-white/25">Step 1 of 5</span>
        <button id="demo-next" class="text-[12px] text-white/30 hover:text-white/60 transition-colors">Next →</button>
      </div>
    </div>

  </div>
</section>

<div class="sep mx-auto max-w-6xl my-0"></div>

<!-- ── DAY IN THE LIFE ───────────────────────────────────── -->
<section class="py-20">
  <div class="mx-auto max-w-5xl px-6">
    <div class="reveal mb-14 text-center">
      <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.15em] text-indigo-400">A real day</p>
      <h2 class="text-[34px] font-black tracking-tight md:text-[42px]">Monday, 9am → 9pm.<br/><span class="gti">FlowOS in the background.</span></h2>
    </div>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-[88px] top-0 bottom-0 w-px tl-line hidden md:block"></div>

      <div class="space-y-10">

        <!-- 8:57 AM — Night Before plan -->
        <div class="reveal flex gap-6 items-start">
          <div class="shrink-0 w-20 text-right hidden md:block">
            <span class="mono text-[11px] text-white/25">8:57 AM</span>
          </div>
          <div class="hidden md:flex shrink-0 items-center justify-center h-5 w-5 rounded-full bg-indigo-500/20 ring-1 ring-indigo-500/40 mt-0.5 relative z-10">
            <div class="h-2 w-2 rounded-full bg-indigo-400"></div>
          </div>
          <div class="flex-1 md:pl-2">
            <div class="md:hidden mb-1"><span class="mono text-[10px] text-white/25">8:57 AM</span></div>
            <p class="text-[13px] font-semibold text-white mb-1">You open your Mac. Night Before plan is waiting.</p>
            <p class="text-[12px] text-white/40 mb-3">FlowOS generated this at 9:03 PM last night from your Google Calendar. You approved it before bed.</p>
            <div class="popover max-w-xs text-[10px]">
              <div class="h-0.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-indigo-500"></div>
              <div class="px-3 py-2.5 border-b border-white/[0.05]">
                <p class="text-[11px] font-semibold text-white">Today's plan — approved ✓</p>
              </div>
              <div class="px-3 py-2 space-y-1.5">
                {[
                  { time: "9:00a", title: "Deep work: auth PR", type: "deep_work", color: "indigo" },
                  { time: "10:00a", title: "Eng standup", type: "meeting", color: "blue" },
                  { time: "10:30a", title: "Code review sprint", type: "deep_work", color: "indigo" },
                  { time: "12:30p", title: "Lunch + recharge", type: "break", color: "emerald" },
                  { time: "2:00p", title: "Design review", type: "meeting", color: "blue" },
                ].map(item => (
                  <div class="flex items-center gap-2">
                    <span class="w-9 text-white/25 shrink-0">{item.time}</span>
                    <span class="flex-1 text-white/65">{item.title}</span>
                    <span class={`px-1.5 py-0.5 rounded text-[8px] bg-${item.color}-500/15 text-${item.color}-300`}>{item.type.replace("_"," ")}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 10:43 AM — Spiral -->
        <div class="reveal flex gap-6 items-start">
          <div class="shrink-0 w-20 text-right hidden md:block">
            <span class="mono text-[11px] text-white/25">10:43 AM</span>
          </div>
          <div class="hidden md:flex shrink-0 items-center justify-center h-5 w-5 rounded-full bg-red-500/20 ring-1 ring-red-500/40 mt-0.5 relative z-10">
            <div class="h-2 w-2 rounded-full bg-red-400"></div>
          </div>
          <div class="flex-1 md:pl-2">
            <div class="md:hidden mb-1"><span class="mono text-[10px] text-white/25">10:43 AM</span></div>
            <p class="text-[13px] font-semibold text-white mb-1">FlowOS fires a spiral alert.</p>
            <p class="text-[12px] text-white/40 mb-3">Standup ended 13 minutes ago. Since then: Slack → Twitter → Spotify → Slack → Discord. 5 switches in 9 minutes.</p>
            <div class="popover max-w-xs">
              <div class="h-1 bg-gradient-to-r from-orange-500 via-red-500 to-orange-500"></div>
              <div class="p-3">
                <div class="flex items-center gap-2.5 mb-3">
                  <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-red-500/15">
                    <svg class="h-4 w-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" /></svg>
                  </div>
                  <div><p class="text-[12px] font-bold text-white">You're spiraling</p><p class="text-[10px] text-white/35">5 switches · 9 min window</p></div>
                </div>
                <div class="flex flex-wrap gap-1 mb-3">
                  {["Slack","Twitter","Spotify","Slack","Discord"].map(a => (
                    <span class="rounded bg-red-500/10 px-1.5 py-0.5 text-[9px] text-red-300 ring-1 ring-red-500/20">{a}</span>
                  ))}
                </div>
                <button class="w-full rounded-xl bg-indigo-600 py-2 text-[10px] font-semibold text-white mb-1">Lock Focus — 30 min</button>
                <button class="w-full rounded-xl bg-white/[0.06] py-2 text-[10px] text-white/55">Close distractions now</button>
              </div>
            </div>
          </div>
        </div>

        <!-- 11:00 AM — Focus locked -->
        <div class="reveal flex gap-6 items-start">
          <div class="shrink-0 w-20 text-right hidden md:block">
            <span class="mono text-[11px] text-white/25">11:00 AM</span>
          </div>
          <div class="hidden md:flex shrink-0 items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 ring-1 ring-emerald-500/40 mt-0.5 relative z-10">
            <div class="h-2 w-2 rounded-full bg-emerald-400"></div>
          </div>
          <div class="flex-1 md:pl-2">
            <div class="md:hidden mb-1"><span class="mono text-[10px] text-white/25">11:00 AM</span></div>
            <p class="text-[13px] font-semibold text-white mb-1">You clicked "Lock Focus." Focus score: 88 and rising.</p>
            <p class="text-[12px] text-white/40 mb-3">Slack, Twitter, Spotify, Discord — all quit. Coding layout applied. 30-minute lock starts now.</p>
            <div class="popover max-w-xs">
              <div class="px-3 py-2.5 flex items-center justify-between border-b border-white/[0.05]">
                <span class="text-[11px] font-semibold text-white">Coding</span>
                <div class="flex items-center gap-1.5 rounded-lg bg-emerald-500/15 px-2 py-0.5">
                  <div class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></div>
                  <span class="text-[10px] font-semibold text-emerald-400">Focus 88 ↑</span>
                </div>
              </div>
              <div class="px-3 py-3">
                <div class="rounded-xl bg-emerald-500/8 ring-1 ring-emerald-500/20 px-3 py-2.5">
                  <p class="text-[11px] font-semibold text-emerald-300 mb-1">Focus locked — 27 min remaining</p>
                  <p class="text-[10px] text-white/35">4 apps closed · Layout: Coding</p>
                  <div class="mt-2 h-1 rounded-full bg-white/[0.06] overflow-hidden">
                    <div class="h-full w-[10%] rounded-full bg-emerald-500/60"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 1:15 PM — Prep alarm -->
        <div class="reveal flex gap-6 items-start">
          <div class="shrink-0 w-20 text-right hidden md:block">
            <span class="mono text-[11px] text-white/25">1:15 PM</span>
          </div>
          <div class="hidden md:flex shrink-0 items-center justify-center h-5 w-5 rounded-full bg-blue-500/20 ring-1 ring-blue-500/40 mt-0.5 relative z-10">
            <div class="h-2 w-2 rounded-full bg-blue-400"></div>
          </div>
