// ── Tab grouping helpers ──────────────────────────────────────
function closeTabs(...ids: string[]) {
  ids.forEach(id => document.getElementById(id)?.classList.add("closing"));
}
function groupTabs(groups: Record<string, string>) {
  for (const [id, cls] of Object.entries(groups)) {
    const el = document.getElementById(id);
    if (!el) continue;
    el.classList.add(cls);
    const badge = el.querySelector(".grp-badge");
    if (badge) badge.classList.add("show");
  }
}
function resetTabs() {
  ["ctab-gh","ctab-tw","ctab-so","ctab-rd","ctab-yt","ctab-mdn"].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove("closing","grp-dev","grp-social","grp-docs","active");
    const badge = el.querySelector(".grp-badge");
    if (badge) { badge.classList.remove("show"); badge.textContent = ""; }
  });
  document.getElementById("ctab-gh")?.classList.add("active");
}
function addTabBadges() {
  const badges: Record<string, [string,string]> = {
    "ctab-gh":  ["Dev","grp-dev"],
    "ctab-so":  ["Dev","grp-dev"],
    "ctab-mdn": ["Dev","grp-dev"],
  };
  for (const [id, [label, cls]] of Object.entries(badges)) {
    const el = document.getElementById(id);
    if (!el) continue;
    let badge = el.querySelector(".grp-badge") as HTMLElement | null;
    if (!badge) {
      badge = document.createElement("span");
      badge.className = "grp-badge";
      el.appendChild(badge);
    }
    badge.textContent = label;
    el.classList.add(cls);
    setTimeout(() => badge!.classList.add("show"), 50);
  }
}

