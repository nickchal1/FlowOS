// ── Demo engine ───────────────────────────────────────────────
let currentScenario = 0;
let currentStep = 0;
let paused = false;
let timer: ReturnType<typeof setTimeout> | null = null;
const STEP_DURATION = 3200;

const logEl     = document.getElementById("demo-log")!;
const uiEl      = document.getElementById("demo-ui")!;
const narrEl    = document.getElementById("demo-narration")!;
const dotsEl    = document.getElementById("demo-dots")!;
const barEl     = document.getElementById("demo-progress-bar")!;
const labelEl   = document.getElementById("demo-step-label")!;
const pauseBtn  = document.getElementById("demo-pause")!;
const prevBtn   = document.getElementById("demo-prev")!;
const nextBtn   = document.getElementById("demo-next")!;

function renderStep() {
  const scenario = SCENARIOS[currentScenario]!;
  const step = scenario.steps[currentStep]!;

  // Narration
  narrEl.textContent = step.narration;

  // Log — render each line with stagger
  logEl.innerHTML = "";
  step.log.forEach((line, i) => {
    const div = document.createElement("div");
    div.innerHTML = line.text;
    div.style.cssText = `${C.norm};animation-delay:${i * 60}ms;opacity:0`;
    div.className = "log-entry";
    logEl.appendChild(div);
  });

  // UI
  uiEl.innerHTML = step.uiHtml;

  // Step label
  labelEl.textContent = `Step ${currentStep + 1} of ${scenario.steps.length}`;

  // Dots
  dotsEl.innerHTML = "";
  scenario.steps.forEach((_, i) => {
    const dot = document.createElement("div");
    dot.style.cssText = `width:6px;height:6px;border-radius:50%;background:${i === currentStep ? "rgba(99,102,241,0.9)" : "rgba(255,255,255,0.15)"};transition:background .3s;cursor:pointer`;
    dot.addEventListener("click", () => { currentStep = i; clearAutoAdvance(); renderStep(); });
    dotsEl.appendChild(dot);
  });

  // Progress bar
  barEl.style.transition = "none";
  barEl.style.width = "0%";
  if (!paused) {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        barEl.style.transition = `width ${STEP_DURATION}ms linear`;
        barEl.style.width = "100%";
      });
    });
  }
}

function advance() {
  const scenario = SCENARIOS[currentScenario]!;
  currentStep = (currentStep + 1) % scenario.steps.length;
  renderStep();
}

function clearAutoAdvance() {
  if (timer) { clearTimeout(timer); timer = null; }
  barEl.style.transition = "none";
  barEl.style.width = "0%";
}

function scheduleAdvance() {
  clearAutoAdvance();
  if (paused) return;
  timer = setTimeout(() => { advance(); scheduleAdvance(); }, STEP_DURATION);
}

pauseBtn.addEventListener("click", () => {
  paused = !paused;
  pauseBtn.textContent = paused ? "▶ Play" : "⏸ Pause";
  if (paused) { clearAutoAdvance(); } else { scheduleAdvance(); renderStep(); }
});

prevBtn.addEventListener("click", () => {
  const scenario = SCENARIOS[currentScenario]!;
  currentStep = (currentStep - 1 + scenario.steps.length) % scenario.steps.length;
  clearAutoAdvance();
  renderStep();
  if (!paused) scheduleAdvance();
});

nextBtn.addEventListener("click", () => {
  advance();
  clearAutoAdvance();
  if (!paused) scheduleAdvance();
});

document.querySelectorAll(".scenario-tab").forEach((btn) => {
  btn.addEventListener("click", (e) => {
    const idx = parseInt((e.currentTarget as HTMLElement).dataset.scenario ?? "0");
    currentScenario = idx;
    currentStep = 0;
    document.querySelectorAll(".scenario-tab").forEach(b => {
      (b as HTMLElement).className = "scenario-tab rounded-xl bg-white/[0.05] px-4 py-2 text-[12px] font-medium text-white/50 ring-1 ring-white/[0.07] hover:bg-white/[0.08] transition-colors";
    });
    (e.currentTarget as HTMLElement).className = "scenario-tab active rounded-xl bg-indigo-600/80 px-4 py-2 text-[12px] font-semibold text-white ring-1 ring-indigo-500/50";
    clearAutoAdvance();
    renderStep();
    if (!paused) scheduleAdvance();
  });
});

// Boot
renderStep();
scheduleAdvance();
</script>

