const ro = new IntersectionObserver(
  es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add("visible"); }),
  { threshold: 0.08, rootMargin: "0px 0px -30px 0px" }
);
document.querySelectorAll(".reveal").forEach(el => ro.observe(el));

// ── Clock ────────────────────────────────────────────────────
function updateClock() {
  const el = document.getElementById("ds-clock");
  if (!el) return;
  const n = new Date();
  el.textContent = n.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
}
updateClock();
setInterval(updateClock, 10000);

// ── Desktop scaling ──────────────────────────────────────────
function scaleDesktop() {
  const outer = document.getElementById("ds-outer");
  const inner = document.getElementById("ds-inner");
  if (!outer || !inner) return;
  const scale = Math.min(outer.clientWidth / 860, 1);
  inner.style.transform = `scale(${scale})`;
  inner.style.transformOrigin = "top left";
  outer.style.height = `${Math.round(scale * 506)}px`;
}
window.addEventListener("resize", scaleDesktop);
scaleDesktop();

// ── Window state helpers ──────────────────────────────────────
interface WinState { x: number; y: number; w: number; h: number; z: number; vis: boolean; }

function setWin(id: string, s: WinState) {
  const el = document.getElementById(id);
  if (!el) return;
  el.style.left    = `${s.x}px`;
  el.style.top     = `${s.y}px`;
  el.style.width   = `${s.w}px`;
  el.style.height  = `${s.h}px`;
  el.style.zIndex  = String(s.z);
  el.style.opacity = s.vis ? "1" : "0";
  el.style.transform = s.vis ? "scale(1)" : "scale(0.94)";
  el.style.pointerEvents = s.vis ? "auto" : "none";
}

